{
    "version": "2026.11.26.3",
    "description": "Local coding workflow orchestrator with CLI, TUI and GUI clients",
    "homepage": "https://github.com/KeiosStarqua/kbots",
    "license": "Unknown",
    "url": "https://github.com/KeiosStarqua/kbots/archive/ca37ea7235bb34c78b5a8cd5570a9ea3c44f7a66.zip",
    "hash": "c62571bc2d4e556e88328c50243127aa8132476a17e1aa3ebf6cd30c2304f034",
    "extract_dir": "kbots-ca37ea7235bb34c78b5a8cd5570a9ea3c44f7a66",
    "depends": [
        "bun",
        "rustup",
        "mingw",
        "git"
    ],
    "installer": {
        "script": [
            "$gnuToolchain = 'stable-x86_64-pc-windows-gnu'",
            "if (-not (rustup toolchain list | Where-Object { $_ -like '*windows-gnu*' })) { rustup toolchain install $gnuToolchain --profile minimal }",
            "if ($LASTEXITCODE -ne 0) { throw 'rustup toolchain install failed' }",
            "$env:RUSTUP_TOOLCHAIN = $gnuToolchain",
            "$mingwBin = Join-Path (appdir mingw) 'current\\bin'",
            "if (Test-Path $mingwBin) { $env:PATH = \"$mingwBin;$env:PATH\" }",
            "powershell -NoProfile -ExecutionPolicy Bypass -File \"$dir\\install.ps1\" -InstallDir \"$dir\" -NoPath -NoDaemon",
            "if ($LASTEXITCODE -ne 0) { throw 'kbots install.ps1 failed' }"
        ]
    },
    "bin": [
        [
            "kbots.exe",
            "kbots"
        ],
        [
            "kbots.exe",
            "kb"
        ],
        [
            "kbots-tui.exe",
            "kbots-tui"
        ],
        [
            "kbots-gui.exe",
            "kbots-gui"
        ]
    ],
    "shortcuts": [
        [
            "kbots-gui.exe",
            "kbots Control Center"
        ]
    ],
    "notes": [
        "Start the local daemon with `kbots daemon start`, then check it with `kb status`.",
        "The source tree stays in the app directory: the daemon runs `bun run daemon` from it.",
        "On Windows the daemon binds authenticated TCP on 127.0.0.1:7878."
    ],
    "##": [
        "kbots publishes no binary release; the manifest builds from a pinned commit, so no deploy tag is needed.",
        "Bump version, url, hash and extract_dir together when moving to a newer commit."
    ]
}
