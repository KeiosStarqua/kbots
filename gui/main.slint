import { Button, CheckBox, LineEdit, ScrollView } from "std-widgets.slint";

export struct TerminalCell { text: string, foreground: color, background: color, bold: bool, italic: bool, underline: bool }
export struct TerminalItem { address: string, name: string, cwd: string, agent: string, status: string }
export struct StatusInfo { name: string, version: string, uptime: string, projects: int, tasks-planning: int, tasks-in-progress: int, tasks-completed: int, tasks-canceled: int, pending-approvals: int, open-detail: string, totals-line: string, daemon-line: string }
export struct ProjectItem { id: string, name: string, path: string, bot-roles: string, created: string }
export struct TaskItem { id: string, title: string, status: string, project: string, created: string }
export struct AgentBindingItem { project: string, role: string, enabled: string, session: string, herdr: string, registered: bool }
export struct ManagedAgentItem { id: string, project: string, role: string, mode: string, status: string, name: string, last-error: string }
export struct ApprovalItem { id: string, operation: string, detail: string, target: string, status: string, created: string }
export struct EventItem { ts: string, kind: string, message: string }

export component MainWindow inherits Window {
    title: "kbots Control Center";
    preferred-width: 1200px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 620px;
    background: #101512;

    in-out property <string> active-page: "Overview";
    in-out property <string> notice: "";
    in-out property <string> detail: "";
    in-out property <bool> has-status: false;
    in-out property <StatusInfo> status: { name: "", version: "", uptime: "", projects: 0, tasks-planning: 0, tasks-in-progress: 0, tasks-completed: 0, tasks-canceled: 0, pending-approvals: 0, open-detail: "", totals-line: "", daemon-line: "" };
    in-out property <[ProjectItem]> projects: [];
    in-out property <[TaskItem]> tasks: [];
    in-out property <[AgentBindingItem]> agent-bindings: [];
    in-out property <[ManagedAgentItem]> managed-agents: [];
    in-out property <[ApprovalItem]> approvals: [];
    in-out property <[EventItem]> events: [];
    in-out property <string> connection-text: "Checking connection…";
    in-out property <bool> connection-ok: false;
    in-out property <string> task-title;
    in-out property <string> task-project;
    in-out property <string> filter-project;
    in-out property <string> project-path;
    in-out property <string> project-name;
    in-out property <string> item-id;
    in-out property <[TerminalItem]> terminals: [];
    in-out property <[string]> attached-terminals: [];
    in-out property <[TerminalCell]> terminal-cells: [];
    in-out property <string> terminal-address;
    in-out property <string> terminal-status: "Herdr Core not connected";
    in-out property <bool> terminal-observe: false;
    in-out property <int> terminal-cols: 100;
    in-out property <int> terminal-rows: 32;
    property <length> watched-width: root.width;
    property <length> watched-height: root.height;

    callback refresh(); callback load-tasks(); callback create-task(); callback cancel-task();
    callback load-projects(); callback register-project(); callback configure-project(); callback start-sessions(); callback load-agents();
    callback load-approvals(); callback approve(); callback load-activity(); callback show-item();
    callback refresh-terminals(); callback attach-terminal(); callback terminal-input(string); callback terminal-resize(int, int); callback terminal-focus(bool); callback terminal-scrollback(int);
    callback update-terminal-size();

    changed watched-width => { root.update-terminal-size(); }
    changed watched-height => { root.update-terminal-size(); }

    update-terminal-size() => {
        let cols = Math.max(40, Math.min(180, Math.floor((root.width / 1px - 260) / 9)));
        let rows = Math.max(12, Math.min(80, Math.floor((root.height / 1px - 240) / 18)));
        root.terminal-cols = cols;
        root.terminal-rows = rows;
        root.terminal-resize(cols, rows);
    }

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 62px; background: #141b17;
            HorizontalLayout {
                padding-left: 22px; padding-right: 22px; spacing: 12px;
                Rectangle { width: 30px; height: 30px; border-radius: 8px; background: #a5d6a7;
                    Text { text: "K"; color: #101512; font-size: 18px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text { text: "kbots  /  Control Center"; color: #eff5f0; font-size: 16px; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.connection-text; color: root.connection-ok ? #a5d6a7 : #f0c674; font-size: 12px; vertical-alignment: center; }
                Button { text: "Refresh status"; clicked => { root.refresh(); } }
            }
        }
        Rectangle { height: 1px; background: #28332c; }
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: 190px; background: #141b17;
                VerticalLayout {
                    padding: 14px; spacing: 5px;
                    Text { text: "WORKSPACE"; color: #86948b; font-size: 10px; font-weight: 700; height: 28px; vertical-alignment: center; }
                    for page[index] in ["Overview", "Projects", "Tasks", "Agents", "Terminals", "Approvals", "Activity log", "Settings"] : Rectangle {
                        height: 40px; border-radius: 7px; background: root.active-page == page ? #243029 : transparent;
                        Text { text: page; color: root.active-page == page ? #eff5f0 : #9daaa1; vertical-alignment: center; x: 12px; }
                        TouchArea { clicked => { root.active-page = page; } }
                    }
                    Rectangle { vertical-stretch: 1; }
                    Text { text: "Local daemon · JSON-RPC"; color: #86948b; font-size: 10px; wrap: word-wrap; }
                }
            }
            Rectangle { width: 1px; background: #28332c; }
            ScrollView {
                VerticalLayout {
                    padding: 28px; spacing: 18px;
                    Text { text: root.active-page; color: #eff5f0; font-size: 26px; font-weight: 700; }
                    if root.active-page == "Overview": VerticalLayout {
                        spacing: 14px;
                        Text { text: "Live workspace status"; color: #9daaa1; }
                        Button { text: "Load system status"; clicked => { root.refresh(); } }
                        if !root.has-status: Text { text: "Load the daemon status to see projects, tasks, and approvals at a glance."; color: #86948b; wrap: word-wrap; }
                        if root.has-status: VerticalLayout {
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 12px;
                                Rectangle {
                                    horizontal-stretch: 1; height: 96px; background: #141b17; border-radius: 10px; border-width: 1px; border-color: #28332c;
                                    VerticalLayout {
                                        padding: 14px; spacing: 4px;
                                        Text { text: "PROJECTS"; color: #86948b; font-size: 10px; font-weight: 700; }
                                        Text { text: root.status.projects; color: #eff5f0; font-size: 28px; font-weight: 700; }
                                        Text { text: "registered"; color: #86948b; font-size: 11px; }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1; height: 96px; background: #141b17; border-radius: 10px; border-width: 1px; border-color: #28332c;
                                    VerticalLayout {
                                        padding: 14px; spacing: 4px;
                                        Text { text: "OPEN TASKS"; color: #86948b; font-size: 10px; font-weight: 700; }
                                        Text { text: root.status.tasks-planning + root.status.tasks-in-progress; color: #eff5f0; font-size: 28px; font-weight: 700; }
                                        Text { text: root.status.open-detail; color: #86948b; font-size: 11px; }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1; height: 96px; background: #141b17; border-radius: 10px; border-width: 1px; border-color: #28332c;
                                    VerticalLayout {
                                        padding: 14px; spacing: 4px;
                                        Text { text: "PENDING APPROVALS"; color: #86948b; font-size: 10px; font-weight: 700; }
                                        Text { text: root.status.pending-approvals; color: root.status.pending-approvals > 0 ? #f0c674 : #eff5f0; font-size: 28px; font-weight: 700; }
                                        Text { text: "waiting for review"; color: #86948b; font-size: 11px; }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1; height: 96px; background: #141b17; border-radius: 10px; border-width: 1px; border-color: #28332c;
                                    VerticalLayout {
                                        padding: 14px; spacing: 4px;
                                        Text { text: "DAEMON"; color: #86948b; font-size: 10px; font-weight: 700; }
                                        Text { text: root.status.uptime; color: #eff5f0; font-size: 22px; font-weight: 700; vertical-alignment: center; }
                                        Text { text: root.status.name + " v" + root.status.version; color: #86948b; font-size: 11px; }
                                    }
                                }
                            }
                            Text { text: root.status.totals-line; color: #dce6de; font-size: 13px; }
                            Text { text: root.status.daemon-line; color: #9daaa1; font-size: 11px; font-family: "monospace"; wrap: word-wrap; }
                        }
                        Text { text: "Use the sections at left to manage projects, tasks, agents, approvals, and activity."; color: #9daaa1; wrap: word-wrap; }
                    }
                    if root.active-page == "Projects": VerticalLayout {
                        spacing: 10px;
                        Text { text: "Register an existing project"; color: #dce6de; font-size: 16px; }
                        LineEdit { placeholder-text: "Absolute project directory"; text <=> root.project-path; }
                        LineEdit { placeholder-text: "Display name (optional)"; text <=> root.project-name; }
                        HorizontalLayout { spacing: 8px;
                            Button { text: "Register project"; clicked => { root.register-project(); } }
                            Button { text: "Configure bot files"; clicked => { root.configure-project(); } }
                            Button { text: "Start bot sessions"; clicked => { root.start-sessions(); } }
                            Button { text: "List projects"; clicked => { root.load-projects(); } }
                            LineEdit { placeholder-text: "Project ID"; text <=> root.item-id; }
                            Button { text: "Show project"; clicked => { root.show-item(); } }
                        }
                        if root.projects.length > 0: VerticalLayout {
                            spacing: 8px;
                            Text { text: "REGISTERED PROJECTS"; color: #86948b; font-size: 10px; font-weight: 700; }
                            for project in root.projects: Rectangle {
                                height: 76px; background: #141b17; border-radius: 8px; border-width: 1px; border-color: #28332c;
                                VerticalLayout {
                                    padding: 10px; spacing: 3px;
                                    HorizontalLayout { spacing: 8px;
                                        Text { text: project.name; color: #eff5f0; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                        Text { text: project.id; color: #a5d6a7; font-family: "monospace"; font-size: 11px; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text { text: project.created; color: #86948b; font-size: 10px; vertical-alignment: center; }
                                    }
                                    Text { text: project.path; color: #9daaa1; font-size: 11px; font-family: "monospace"; wrap: word-wrap; }
                                    Text { text: "bots: " + project.bot-roles; color: #86948b; font-size: 10px; }
                                }
                                TouchArea { clicked => { root.item-id = project.id; } }
                            }
                        }
                    }
                    if root.active-page == "Tasks": VerticalLayout {
                        spacing: 10px;
                        Text { text: "Create and inspect workflow tasks"; color: #dce6de; font-size: 16px; }
                        LineEdit { placeholder-text: "Task description"; text <=> root.task-title; }
                        HorizontalLayout { spacing: 8px;
                            LineEdit { placeholder-text: "Project ID (optional)"; text <=> root.task-project; }
                            Button { text: "Create task"; clicked => { root.create-task(); } }
                            LineEdit { placeholder-text: "Filter by project"; text <=> root.filter-project; }
                            Button { text: "List tasks"; clicked => { root.load-tasks(); } }
                        }
                        HorizontalLayout { spacing: 8px;
                            LineEdit { placeholder-text: "Task ID"; text <=> root.item-id; }
                            Button { text: "Show task"; clicked => { root.show-item(); } }
                            Button { text: "Cancel task"; clicked => { root.cancel-task(); } }
                        }
                        if root.tasks.length > 0: VerticalLayout {
                            spacing: 8px;
                            Text { text: "TASKS"; color: #86948b; font-size: 10px; font-weight: 700; }
                            for task in root.tasks: Rectangle {
                                height: 66px; background: #141b17; border-radius: 8px; border-width: 1px; border-color: #28332c;
                                VerticalLayout {
                                    padding: 10px; spacing: 3px;
                                    HorizontalLayout { spacing: 10px;
                                        Text { text: task.id; color: #a5d6a7; font-family: "monospace"; font-size: 11px; vertical-alignment: center; }
                                        Text { text: task.title; color: #eff5f0; font-size: 13px; font-weight: 600; vertical-alignment: center; wrap: word-wrap; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Rectangle {
                                            height: 22px; width: 96px; border-radius: 11px; background: #243029;
                                            Text { text: task.status; color: task.status == "completed" ? #a5d6a7 : task.status == "canceled" ? #86948b : #f0c674; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                    Text { text: (task.project != "" ? task.project : "no project") + "  ·  " + task.created; color: #86948b; font-size: 10px; font-family: "monospace"; }
                                }
                                TouchArea { clicked => { root.item-id = task.id; } }
                            }
                        }
                    }
                    if root.active-page == "Agents": VerticalLayout {
                        spacing: 12px;
                        HorizontalLayout { spacing: 8px;
                            Button { text: "List agents"; clicked => { root.load-agents(); } }
                            Text { text: "Agent execution and sessions are owned by the daemon."; color: #9daaa1; vertical-alignment: center; }
                        }
                        if root.managed-agents.length > 0: VerticalLayout {
                            spacing: 8px;
                            Text { text: "MANAGED AGENTS"; color: #86948b; font-size: 10px; font-weight: 700; }
                            for agent in root.managed-agents: Rectangle {
                                height: 60px; background: #141b17; border-radius: 8px; border-width: 1px; border-color: #28332c;
                                VerticalLayout {
                                    padding: 10px; spacing: 3px;
                                    HorizontalLayout { spacing: 10px;
                                        Text { text: agent.id; color: #a5d6a7; font-family: "monospace"; font-size: 11px; vertical-alignment: center; }
                                        Text { text: agent.role + " · " + agent.mode; color: #eff5f0; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                                        Text { text: agent.name; color: #9daaa1; font-size: 11px; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text { text: agent.status; color: agent.status == "running" ? #a5d6a7 : agent.status == "error" ? #e57373 : agent.status == "stopped" ? #86948b : #f0c674; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                    }
                                    Text { text: agent.project + (agent.last-error != "" ? "  ·  error: " + agent.last-error : ""); color: agent.last-error != "" ? #e57373 : #86948b; font-size: 10px; wrap: word-wrap; }
                                }
                            }
                        }
                        if root.agent-bindings.length > 0: VerticalLayout {
                            spacing: 8px;
                            Text { text: "ROLE BINDINGS"; color: #86948b; font-size: 10px; font-weight: 700; }
                            for binding in root.agent-bindings: Rectangle {
                                height: 52px; background: #141b17; border-radius: 8px; border-width: 1px; border-color: #28332c;
                                VerticalLayout {
                                    padding: 10px; spacing: 3px;
                                    HorizontalLayout { spacing: 10px;
                                        Text { text: binding.role; color: #eff5f0; font-family: "monospace"; font-size: 12px; font-weight: 700; width: 40px; vertical-alignment: center; }
                                        Text { text: binding.project; color: #9daaa1; font-size: 11px; vertical-alignment: center; wrap: word-wrap; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text { text: binding.enabled; color: binding.enabled == "enabled" ? #a5d6a7 : binding.enabled == "disabled" ? #86948b : #9daaa1; font-size: 10px; vertical-alignment: center; }
                                        if binding.herdr != "": Text { text: binding.herdr; color: #f0c674; font-size: 10px; vertical-alignment: center; }
                                        if !binding.registered: Text { text: "not registered"; color: #f0c674; font-size: 10px; vertical-alignment: center; }
                                    }
                                    Text { text: "session " + binding.session; color: #86948b; font-size: 9px; font-family: "monospace"; }
                                }
                            }
                        }
                    }
                    if root.active-page == "Terminals": VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Discover live terminals"; clicked => { root.refresh-terminals(); } }
                            LineEdit { placeholder-text: "Terminal address (for example t7)"; text <=> root.terminal-address; }
                            Button { text: "Attach"; clicked => { root.attach-terminal(); } }
                            CheckBox { text: "Observe only"; checked <=> root.terminal-observe; }
                            Text { text: root.terminal-status; color: #a5d6a7; vertical-alignment: center; }
                        }
                        Rectangle {
                            height: 132px; background: #141b17; border-radius: 8px;
                            ScrollView {
                                HorizontalLayout {
                                    spacing: 8px;
                                    for terminal in root.terminals: Rectangle {
                                        width: 220px; height: 116px; border-radius: 7px;
                                        background: root.terminal-address == terminal.address ? #243029 : #101512;
                                        border-width: 1px; border-color: #28332c;
                                        VerticalLayout {
                                            padding: 10px; spacing: 3px;
                                            Text { text: terminal.name + " · " + terminal.address; color: #eff5f0; font-weight: 700; }
                                            Text { text: terminal.agent + " · " + terminal.status; color: #a5d6a7; }
                                            Text { text: terminal.cwd; color: #9daaa1; font-size: 10px; wrap: word-wrap; }
                                        }
                                        TouchArea { clicked => { root.terminal-address = terminal.address; } }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Text { text: "ATTACHED"; color: #86948b; font-size: 10px; vertical-alignment: center; }
                            for address in root.attached-terminals: Button {
                                text: address;
                                clicked => { root.terminal-address = address; root.attach-terminal(); }
                            }
                        }
                        Rectangle {
                            background: #101218; border-width: 1px; border-color: #28332c; border-radius: 8px;
                            min-height: 576px;
                            // A cell grid preserves the colors and cursor positioning supplied by VT output.
                            for cell[index] in root.terminal-cells: Rectangle {
                                x: Math.mod(index, root.terminal-cols) * 9px;
                                y: Math.floor(index / root.terminal-cols) * 18px;
                                width: 9px; height: 18px; background: cell.background;
                                Text { text: cell.text; color: cell.foreground; font-family: "monospace"; font-size: 13px; font-weight: cell.bold ? 700 : 400; font-italic: cell.italic; }
                                if cell.underline: Rectangle { x: 0px; y: 16px; width: 9px; height: 1px; background: cell.foreground; }
                            }
                            focus-scope := FocusScope {
                                x: 0; y: 0; width: 1px; height: 1px;
                                changed has-focus => { root.terminal-focus(self.has-focus); }
                                key-pressed(event) => {
                                    if (event.modifiers.control && event.text == "c") { root.terminal-input("\u{3}"); return accept; }
                                    if (event.modifiers.control && event.text == "d") { root.terminal-input("\u{4}"); return accept; }
                                    if (event.modifiers.control && event.text == "z") { root.terminal-input("\u{1a}"); return accept; }
                                    if (event.text == Key.Return) { root.terminal-input("\u{d}"); return accept; }
                                    if (event.text == Key.Backspace) { root.terminal-input("\u{7f}"); return accept; }
                                    if (event.text == Key.Tab) { root.terminal-input("\u{9}"); return accept; }
                                    if (event.text == Key.Escape) { root.terminal-input("\u{1b}"); return accept; }
                                    if (event.text == Key.Home) { root.terminal-input("\u{1b}[H"); return accept; }
                                    if (event.text == Key.End) { root.terminal-input("\u{1b}[F"); return accept; }
                                    if (event.text == Key.Delete) { root.terminal-input("\u{1b}[3~"); return accept; }
                                    if (event.text == Key.PageUp) { root.terminal-scrollback(24); return accept; }
                                    if (event.text == Key.PageDown) { root.terminal-scrollback(-24); return accept; }
                                    if (event.text == Key.UpArrow) { root.terminal-input("\u{1b}[A"); return accept; }
                                    if (event.text == Key.DownArrow) { root.terminal-input("\u{1b}[B"); return accept; }
                                    if (event.text == Key.RightArrow) { root.terminal-input("\u{1b}[C"); return accept; }
                                    if (event.text == Key.LeftArrow) { root.terminal-input("\u{1b}[D"); return accept; }
                                    if (event.text != "") { root.terminal-input(event.text); return accept; }
                                    return reject;
                                }
                            }
                            TouchArea { clicked => { focus-scope.focus(); } }
                        }
                    }
                    if root.active-page == "Approvals": VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout { spacing: 8px;
                            Button { text: "List approvals"; clicked => { root.load-approvals(); } }
                            LineEdit { placeholder-text: "Approval ID"; text <=> root.item-id; }
                            Button { text: "Approve"; clicked => { root.approve(); } }
                        }
                        if root.approvals.length > 0: VerticalLayout {
                            spacing: 8px;
                            Text { text: "APPROVALS"; color: #86948b; font-size: 10px; font-weight: 700; }
                            for approval in root.approvals: Rectangle {
                                height: approval.detail != "" ? 76px : 56px; background: #141b17; border-radius: 8px; border-width: 1px; border-color: #28332c;
                                VerticalLayout {
                                    padding: 10px; spacing: 3px;
                                    HorizontalLayout { spacing: 10px;
                                        Text { text: approval.id; color: #a5d6a7; font-family: "monospace"; font-size: 11px; vertical-alignment: center; }
                                        Text { text: approval.operation; color: #eff5f0; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Rectangle {
                                            height: 22px; width: 84px; border-radius: 11px; background: #243029;
                                            Text { text: approval.status; color: approval.status == "approved" ? #a5d6a7 : #f0c674; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                    if approval.detail != "": Text { text: approval.detail; color: #9daaa1; font-size: 11px; wrap: word-wrap; }
                                    Text { text: approval.target + "  ·  " + approval.created; color: #86948b; font-size: 10px; font-family: "monospace"; }
                                }
                                TouchArea { clicked => { root.item-id = approval.id; } }
                            }
                        }
                    }
                    if root.active-page == "Activity log": VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout { spacing: 8px;
                            Button { text: "Load recent activity"; clicked => { root.load-activity(); } }
                            Text { text: "Returns the latest events exposed by the daemon."; color: #9daaa1; vertical-alignment: center; }
                        }
                        if root.events.length > 0: VerticalLayout {
                            spacing: 8px;
                            Text { text: "RECENT EVENTS"; color: #86948b; font-size: 10px; font-weight: 700; }
                            for event in root.events: Rectangle {
                                height: 52px; background: #141b17; border-radius: 8px; border-width: 1px; border-color: #28332c;
                                VerticalLayout {
                                    padding: 10px; spacing: 3px;
                                    HorizontalLayout { spacing: 10px;
                                        Text { text: event.ts; color: #86948b; font-family: "monospace"; font-size: 10px; vertical-alignment: center; }
                                        Text { text: event.kind; color: #a5d6a7; font-family: "monospace"; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                    }
                                    Text { text: event.message; color: #dce6de; font-size: 12px; wrap: word-wrap; }
                                }
                            }
                        }
                    }
                    if root.active-page == "Settings": VerticalLayout {
                        spacing: 8px;
                        Text { text: "Connection"; color: #dce6de; font-size: 16px; }
                        Text { text: "Socket discovery: --socket=PATH, KBOTS_SOCKET, XDG_RUNTIME_DIR/kbots.sock, then ~/.local/run/kbots.sock"; color: #9daaa1; wrap: word-wrap; }
                        Button { text: "Check daemon"; clicked => { root.refresh(); } }
                    }
                    Rectangle { height: 1px; background: #28332c; }
                    if root.notice != "": Text { text: root.notice; color: #f0c674; font-size: 12px; wrap: word-wrap; }
                    if root.detail != "": VerticalLayout {
                        spacing: 6px;
                        Text { text: "RESULT"; color: #86948b; font-size: 10px; font-weight: 700; }
                        Text { text: root.detail; color: #dce6de; font-size: 12px; font-family: "monospace"; wrap: word-wrap; }
                    }
                }
            }
        }
    }
}
